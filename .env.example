# Copy to .env and fill in before `docker compose up -d`.
# See https://github.com/super-productivity/super-productivity/blob/master/packages/super-sync-server/env.example
# for the full list of options this image supports.

# --- Required ---
JWT_SECRET=                 # openssl rand -base64 32
POSTGRES_PASSWORD=          # openssl rand -base64 24
PUBLIC_URL=http://localhost:1900   # must be https:// in production

# --- Passkey / WebAuthn (required for passkey login) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:1900

# --- CORS ---
CORS_ORIGINS=https://app.super-productivity.com

# --- SMTP (required for email verification) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Super Productivity Sync" <noreply@your-domain.com>

# --- Addl Settings ---
SUPERSYNC_IMAGE=webstas/supersync:latest
SUPERSYNC_DEFAULT_STORAGE_QUOTA_BYTES=104857600
SUPERSYNC_BATCH_UPLOAD=true
SUPERSYNC_PAYLOAD_BYTES_BACKFILL_COMPLETE=true

# --- Optional ---
# ALLOWED_EMAILS=you@example.com,*@your-domain.com

# Sync rate limits. Upstream hardcodes these; this image reads them from the env
# at container start (see README). Unset/empty/non-numeric = the upstream default.
# SYNC_UPLOAD_RATE_LIMIT_MAX    per-user + per-IP POST /api/sync/ops cap  (default 100/min)
# SYNC_GLOBAL_RATE_LIMIT_MAX    global per-IP request cap                 (default 500/15min)
# SYNC_SNAPSHOT_RATE_LIMIT_MAX  per-IP POST /api/sync/snapshot cap        (default 10/15min)
#   Snapshot uploads are full-state (large body + replay). Behind a proxy every
#   client shares one IP, so 10/15min is the whole instance. Raise if clients
#   legitimately resync often; a client hitting it repeatedly is usually a
#   resync loop worth diagnosing, not just a low cap.
# SYNC_UPLOAD_RATE_LIMIT_MAX=1000
# SYNC_GLOBAL_RATE_LIMIT_MAX=5000
# SYNC_SNAPSHOT_RATE_LIMIT_MAX=100