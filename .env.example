# Copy to .env and fill in before `docker compose up -d`.
# See https://github.com/super-productivity/super-productivity/blob/master/packages/super-sync-server/env.example
# for the full list of options this image supports.

# --- Required ---
JWT_SECRET=                 # openssl rand -base64 32
POSTGRES_PASSWORD=          # openssl rand -base64 24
PUBLIC_URL=http://localhost:1900   # must be https:// in production

# --- Passkey / WebAuthn (required for passkey login) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:1900

# --- CORS ---
CORS_ORIGINS=https://app.super-productivity.com

# --- SMTP (required for email verification) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Super Productivity Sync" <noreply@your-domain.com>

# --- User Settings ---
SUPERSYNC_IMAGE=webstas/supersync:latest
SUPERSYNC_DEFAULT_STORAGE_QUOTA_BYTES=104857600

# --- Optional ---
# ALLOWED_EMAILS=you@example.com,*@your-domain.com